DATABASE_URL="postgresql://idms:idms_dev@localhost:5432/internal_device_management?schema=public"
JWT_SECRET="change-me-in-prod"
JWT_EXPIRES_IN="1d"
PORT=3000
CORS_ORIGIN="http://localhost:5173"

# Resend (https://resend.com) — lấy API key ở dashboard.
# onboarding@resend.dev chỉ gửi được tới email của chính tài khoản Resend; muốn gửi cho người khác phải verify domain.
RESEND_API_KEY="re_xxx"
RESEND_FROM_EMAIL="IDMS <onboarding@resend.dev>"

# Chỉ dùng cho dev: `npx prisma db seed` tạo thêm user dev / Dev@1234 với email này.
# Đặt bằng email tài khoản Resend để nhận được mã OTP khi test quên mật khẩu.
# DEV_USER_EMAIL="ban@example.com"
